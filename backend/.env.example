DJANGO_SECRET_KEY=change-this-for-local-development
MYSQL_DATABASE=organ_donation_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_CHAIN_ID=5777

# Optional. If blank, Django reads the address from build/contracts/OrganDonation.json.
ORGAN_DONATION_CONTRACT_ADDRESS=

# Optional. If blank, Web3.py uses the first unlocked Ganache account.
ORGAN_DONATION_FROM_ADDRESS=
